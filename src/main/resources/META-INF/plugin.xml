<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.pauldillon.webchathelper</id>
    <name>WebChatHelper</name>
    <vendor>Paul Dillon</vendor>

    <!-- #3Q0: the plugin drives the ChatGPT web UI only; it does not use any OpenAI APIs. -->
    <description><![CDATA[
        <p>Runs the ChatGPT web UI inside the IDE and automates working with project files.</p>
        <ul>
            <li>ChatGPT in an embedded browser (JCEF) in a tool window on the right of the IDE.</li>
            <li>Attach project files and folders to the prompt, with configurable exclusions.</li>
            <li>Diff code from ChatGPT's responses against project files.</li>
        </ul>
        <p>Uses the ChatGPT website with your own login. It does not use any OpenAI APIs.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- #R4F: the embedded browser (JBCefBrowser) is provided by the bundled "Web Browser (JCEF)" plugin. -->
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- #0E6: anchored on the right, like other AI tool windows. -->
        <toolWindow id="WebChatHelper"
                    anchor="right"
                    icon="/icons/webChatToolWindow.svg"
                    factoryClass="com.pauldillon.webchathelper.toolwindow.WebChatToolWindowFactory"/>
    </extensions>

    <actions>
        <!-- Button row under the browser; the attach (#Z7H) and settings (#7IO) actions are added here. -->
        <group id="WebChatHelper.BrowserToolbar">
            <!-- #K2W -->
            <action id="WebChatHelper.ReloadBrowser"
                    class="com.pauldillon.webchathelper.toolwindow.ReloadBrowserAction"
                    text="Reload ChatGPT"
                    description="Recreate the embedded browser and reopen the current ChatGPT page"
                    icon="AllIcons.Actions.Refresh"/>
            <!-- #W4R -->
            <action id="WebChatHelper.GoHome"
                    class="com.pauldillon.webchathelper.toolwindow.GoHomeAction"
                    text="ChatGPT Start Page"
                    description="Go back to the ChatGPT start page"
                    icon="AllIcons.Nodes.HomeFolder"/>
        </group>
    </actions>
</idea-plugin>
